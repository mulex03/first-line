<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Random Fun Facts</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .container {
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            padding: 60px 40px;
            max-width: 600px;
            width: 100%;
            text-align: center;
        }

        h1 {
            color: #333;
            margin-bottom: 10px;
            font-size: 2.5em;
        }

        .subtitle {
            color: #999;
            margin-bottom: 40px;
            font-size: 0.95em;
        }

        .fact-box {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 40px;
            border-radius: 15px;
            margin-bottom: 30px;
            min-height: 150px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3em;
            line-height: 1.6;
            font-weight: 500;
            animation: fadeIn 0.5s ease-in;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .button-group {
            display: flex;
            gap: 15px;
            justify-content: center;
        }

        button {
            background: #667eea;
            color: white;
            border: none;
            padding: 12px 30px;
            font-size: 1em;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-weight: 600;
        }

        button:hover {
            background: #764ba2;
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
        }

        button:active {
            transform: translateY(0);
        }

        .copy-btn {
            background: #4CAF50;
            padding: 8px 15px;
            font-size: 0.9em;
        }

        .copy-btn:hover {
            background: #45a049;
        }

        .counter {
            color: #999;
            font-size: 0.9em;
            margin-top: 20px;
        }

        @media (max-width: 600px) {
            .container {
                padding: 40px 25px;
            }

            h1 {
                font-size: 2em;
            }

            .fact-box {
                font-size: 1.1em;
                padding: 30px;
                min-height: 120px;
            }

            .button-group {
                flex-direction: column;
            }

            button {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>🎉 Fun Facts</h1>
        <p class="subtitle">Click the button to discover amazing facts!</p>
        
        <div class="fact-box" id="factBox">
            Loading your first fun fact...
        </div>

        <div class="button-group">
            <button onclick="getNewFact()">🔄 Get New Fact</button>
            <button class="copy-btn" onclick="copyFact()">📋 Copy Fact</button>
        </div>

        <div class="counter">
            <span id="factCount">0</span> facts discovered
        </div>
    </div>

    <script>
        const facts = [
            "Honey never spoils. Archaeologists have found 3,000-year-old honey in Egyptian tombs that was still edible!",
            "A group of flamingos is called a 'flamboyance'.",
            "Octopuses have three hearts - two pump blood to the gills, while the third pumps it to the rest of the body.",
            "The shortest war in history was between Britain and Zanzibar on August 27, 1896, lasting only 38 to 45 minutes.",
            "Cleopatra lived closer to the invention of the iPhone than to the building of the Great Pyramid.",
            "Bananas are berries, but strawberries aren't!",
            "A single bolt of lightning contains enough energy to toast 100,000 slices of bread.",
            "Wombats produce cube-shaped droppings to mark their territory.",
            "The smell of petrichor (rain on dry earth) comes from a compound called geosmin, produced by bacteria.",
            "Butterflies taste with their feet to find out whether the leaf they sit on is good to lay eggs on.",
            "A day on Venus is longer than its year.",
            "Penguins have knees - they're just hidden under their feathers.",
            "The fingerprints of koalas are so similar to human fingerprints that they could confuse crime scene investigators!",
            "Cows have best friends and get stressed when separated from them.",
            "The Great Wall of China isn't visible from space without aid.",
            "Otters hold hands while sleeping so they don't drift apart.",
            "A group of crows is called a 'murder'.",
            "Horses cannot vomit.",
            "The Eiffel Tower grows about 6 inches taller each summer due to thermal expansion.",
            "Scotland's national animal is a unicorn.",
            "Your nose can remember 50,000 different scents.",
            "Slime eels can tie themselves in a knot.",
            "A jiffy is an actual unit of time equal to one trillionth of a second.",
            "Puffins can fly up to 88 km/h (55 mph).",
            "The flea can jump 350 times its body length - that's like a human jumping the length of a football field!"
        ];

        let factCount = 0;
        let currentFact = '';

        function getNewFact() {
            const randomIndex = Math.floor(Math.random() * facts.length);
            currentFact = facts[randomIndex];
            document.getElementById('factBox').textContent = currentFact;
            factCount++;
            document.getElementById('factCount').textContent = factCount;
        }

        function copyFact() {
            if (currentFact) {
                navigator.clipboard.writeText(currentFact).then(() => {
                    const btn = event.target;
                    const originalText = btn.textContent;
                    btn.textContent = '✅ Copied!';
                    setTimeout(() => {
                        btn.textContent = originalText;
                    }, 2000);
                });
            }
        }

        // Load the first fact on page load
        window.addEventListener('load', getNewFact);
    </script>
</body>
</html>
